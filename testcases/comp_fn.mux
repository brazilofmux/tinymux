#
# comp_fn.mux - Test Cases for comp().
#
@create test_comp_fn
-
@set test_comp_fn=INHERIT QUIET
-
#
# Beginning of Test Cases
#
&tr.tc000 test_comp_fn=
  @log smoke=Beginning comp() test cases.
-
#
# Test Case #1 - Basic string comparison operations.
#
&tr.tc001 test_comp_fn=
  @if strmatch(
        setr(0,sha1(
            [comp(a,b)]
            [comp(a,a)]
            [comp(b,a)]
          )
        ),
        671CC6A3DFA9EB58EA4236AFC97998D9CDDD6C08
      )=
  {
    @log smoke=TC001: comp basic operations. Succeeded.
  },
  {
    @log smoke=TC001: comp basic operations. Failed (%q0).
  }
-
#
# Test Case #2 - Compare Unicode strings.
# Precomposed e-acute vs combining (both normalize to same via NFC).
# Also compare different Unicode characters.
#
&tr.tc002 test_comp_fn=
  @if strmatch(
        setr(0,sha1(
            [comp(chr(233),chr(101 769))]
            [comp(chr(233),chr(252))]
            [comp(chr(65296),chr(65296))]
          )
        ),
        FB1D36F760525763E048979F5DEDBE0D6F280FF3
      )=
  {
    @log smoke=TC002: comp Unicode. Succeeded.
  },
  {
    @log smoke=TC002: comp Unicode. Failed (%q0).
  }
-
#
# Test Case #3 - DUCET contractions: l/L with a middle dot, and three code points.
#
# DUCET contracts l and L with U+00B7, so the dot acts as an accent on the
# l (Catalan "ela geminada", col.lecci\u00f3) rather than as punctuation.
# The ASCII fast path used to assume nothing contracts with an ASCII
# letter, so "L." sorted after "L!".  The last line is a three-code-point
# contraction (Tibetan U+0FB2 U+0F71 U+0F80), whose table was generated but
# never read.  Expected values are ICU root's.
#
&tr.tc003 test_comp_fn=
  @if cand(
        eq(comp(L[chr(183)],L!),-1),
        eq(comp(l[chr(183)]a,la),1),
        eq(comp(col[chr(183)]lecci[chr(243)],colla),1),
        eq(comp([chr(4018)][chr(3953)][chr(3968)],[chr(4018)][chr(3968)]),1)
      )=
  {
    @log smoke=TC003: comp DUCET contractions. Succeeded.
  },
  {
    @log smoke=TC003: comp DUCET contractions. Failed ([comp(L[chr(183)],L!)] [comp(l[chr(183)]a,la)] [comp(col[chr(183)]lecci[chr(243)],colla)] [comp([chr(4018)][chr(3953)][chr(3968)],[chr(4018)][chr(3968)])]).
  }
-
#
# Test Case #4 - implicit weights whose trail is 0x8000.
#
# An ideograph's second collation element is (cp & 0x7FFF) | 0x8000, and
# the 15-bit primary mask turned it into 0 -- an ignorable -- for U+8000,
# U+18000, U+20000, U+28000 and U+30000.  Those then compared against
# whatever followed them.  Expected values follow UCA's code-point order
# for Han (DUCET), not ICU, whose root collation orders Han by radical and
# stroke.  The last line, a proper prefix, guards the fix itself.
#
&tr.tc004 test_comp_fn=
  @if cand(
        eq(comp([chr(32768)]b,[chr(32769)]a),-1),
        eq(comp([chr(131072)]z,[chr(131073)]a),-1),
        eq(comp([chr(131072)]z,[chr(135168)]a),-1),
        eq(comp([chr(32768)],[chr(32768)]a),-1)
      )=
  {
    @log smoke=TC004: comp implicit trail. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC004: comp implicit trail. Failed ([comp([chr(32768)]b,[chr(32769)]a)] [comp([chr(131072)]z,[chr(131073)]a)] [comp([chr(131072)]z,[chr(135168)]a)] [comp([chr(32768)],[chr(32768)]a)]).;
    @trig me/tr.done
  }
-
&tr.done test_comp_fn=
  @log smoke=End comp() test cases.;
  @notify smoke
-
drop test_comp_fn
-
#
# End of Test Cases
#
