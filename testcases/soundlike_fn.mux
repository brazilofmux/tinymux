#
# soundlike_fn.mux - Test Cases for soundlike().
#
# soundlike(<string1>,<string2>) returns 1 when the two strings sound
# alike (a soundex-style comparison) and 0 when they do not.
#
# NOTE: soundlike() has no entry in help.txt, so unlike the rest of this
# coverage work the expectations here are not taken from documentation.
# They are limited to properties any soundex comparison must satisfy —
# reflexivity, symmetry, a classic matching pair and a clearly
# non-matching pair — rather than pinning implementation detail that no
# contract backs up.
#
@create test_soundlike_fn
-
@set test_soundlike_fn=INHERIT QUIET
-
&tr.tc000 test_soundlike_fn=
  @log smoke=Beginning soundlike() test cases.
-
#
# Test Case #1 - Classic matching and non-matching pairs.
#
&tr.tc001 test_soundlike_fn=
  @if cand(
        eq(soundlike(smith,smyth), 1),
        eq(soundlike(smith,jones), 0)
      )=
  {
    @log smoke=TC001: soundlike matching pairs. Succeeded.
  },
  {
    @log smoke=TC001: soundlike matching pairs. Failed (match=[soundlike(smith,smyth)] nomatch=[soundlike(smith,jones)]).
  }
-
#
# Test Case #2 - Reflexive and symmetric: a string sounds like itself,
# and argument order does not change the answer.
#
&tr.tc002 test_soundlike_fn=
  @if cand(
        eq(soundlike(smith,smith), 1),
        eq(soundlike(smyth,smith), soundlike(smith,smyth)),
        eq(soundlike(jones,smith), soundlike(smith,jones))
      )=
  {
    @log smoke=TC002: soundlike reflexive and symmetric. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC002: soundlike reflexive and symmetric. Failed (self=[soundlike(smith,smith)] sym1=[soundlike(smyth,smith)]/[soundlike(smith,smyth)] sym2=[soundlike(jones,smith)]/[soundlike(smith,jones)]).;
    @trig me/tr.done
  }
-
&tr.done test_soundlike_fn=
  @log smoke=End soundlike() test cases.;
  @notify smoke
-
drop test_soundlike_fn
-
#
# End of Test Cases
#
