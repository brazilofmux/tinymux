#
# hastype_fn.mux - Test Cases for hastype().
#
# hastype(<object>,<type>) returns 1 when <object> is of the named type
# and 0 otherwise.  Documented valid types are ROOM, EXIT, PLAYER and
# THING; an invalid type is documented to return #-1.
#
# #1168 resolved both historical divergences in the documented
# direction: the type is matched as a full case-insensitive name (the
# old code tested only the first letter, so TRUMPET passed as THING),
# and the invalid-type arm returns the bare error (it used to fall
# through and emit '#-1 NO SUCH TYPE0').  TC004 pins both.
#
@create test_hastype_fn
-
@set test_hastype_fn=INHERIT QUIET
-
&tr.tc000 test_hastype_fn=
  @log smoke=Beginning hastype() test cases.
-
#
# Test Case #1 - A THING is a THING and is nothing else.
#
&tr.tc001 test_hastype_fn=
  @if cand(
        eq(hastype(me,THING), 1),
        eq(hastype(me,ROOM), 0),
        eq(hastype(me,EXIT), 0),
        eq(hastype(me,PLAYER), 0),
        strmatch(type(me), THING)
      )=
  {
    @log smoke=TC001: hastype THING exclusivity. Succeeded.
  },
  {
    @log smoke=TC001: hastype THING exclusivity. Failed (thing=[hastype(me,THING)] room=[hastype(me,ROOM)] exit=[hastype(me,EXIT)] player=[hastype(me,PLAYER)] type=[type(me)]).
  }
-
#
# Test Case #2 - Room #0 is a ROOM, and hastype() agrees with type() on
# every object tested.
#
&tr.tc002 test_hastype_fn=
  @if cand(
        eq(hastype(#0,ROOM), 1),
        eq(hastype(#0,THING), 0),
        strmatch(type(#0), ROOM),
        eq(hastype(me,[type(me)]), 1),
        eq(hastype(#0,[type(#0)]), 1)
      )=
  {
    @log smoke=TC002: hastype agrees with type. Succeeded.
  },
  {
    @log smoke=TC002: hastype agrees with type. Failed (room=[hastype(#0,ROOM)] notthing=[hastype(#0,THING)] type=[type(#0)] self=[hastype(me,[type(me)])] self0=[hastype(#0,[type(#0)])]).
  }
-
#
# Test Case #3 - An object that cannot be matched is an error, not 0.
#
&tr.tc003 test_hastype_fn=
  @if cand(
        strmatch(hastype(#-1,THING), #-1*),
        strmatch(hastype(nosuchobjecthere,THING), #-1*)
      )=
  {
    @log smoke=TC003: hastype bad object. Succeeded.
  },
  {
    @log smoke=TC003: hastype bad object. Failed (dbref=[hastype(#-1,THING)] name=[hastype(nosuchobjecthere,THING)]).
  }
-
#
# Test Case #4 - The type must be a full (case-insensitive) name; an
# invalid type is exactly '#-1 NO SUCH TYPE' with no boolean appended
# (#1168: TRUMPET/T formerly passed as THING, and the error read
# '#-1 NO SUCH TYPE0').
#
&tr.tc004 test_hastype_fn=
  @if cand(
        strmatch(hastype(me,TRUMPET), #-1 NO SUCH TYPE),
        strmatch(hastype(me,T), #-1 NO SUCH TYPE),
        strmatch(hastype(#0,RUBBISH), #-1 NO SUCH TYPE),
        strmatch(hastype(me,ZEBRA), #-1 NO SUCH TYPE),
        eq(hastype(me,thing), 1),
        eq(hastype(me,Thing), 1),
        eq(hastype(#0,room), 1)
      )=
  {
    @log smoke=TC004: hastype full-name match and exact error. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC004: hastype full-name match and exact error. Failed (trumpet=.[hastype(me,TRUMPET)]. t=.[hastype(me,T)]. rubbish=.[hastype(#0,RUBBISH)]. zebra=.[hastype(me,ZEBRA)]. lc=[hastype(me,thing)] mixed=[hastype(me,Thing)] lcroom=[hastype(#0,room)]).;
    @trig me/tr.done
  }
-
&tr.done test_hastype_fn=
  @log smoke=End hastype() test cases.;
  @notify smoke
-
drop test_hastype_fn
-
#
# End of Test Cases
#
