#
# mul_fn.mux - Test Cases for mul().
#
@create test_mul_fn
-
@set test_mul_fn=INHERIT QUIET
-
#
# Beginning of Test Cases
#
&tr.tc000 test_mul_fn=
  @log smoke=Beginning mul() test cases.
-
#
# Test Case #1 - Basic multiplication operations.
#
&tr.tc001 test_mul_fn=
  @if cand(
        eq(mul(2,3), 6),
        eq(mul(2,3,4), 24)
      )=
  {
    @log smoke=TC001: mul basic operations. Succeeded.
  },
  {
    @log smoke=TC001: mul basic operations. Failed (mul(2%,3)=[mul(2,3)] mul(2%,3%,4)=[mul(2,3,4)]).;
  }
-
#
# Test Case #2 - Decimal, sign, and coercion cases.
#
&tr.tc002 test_mul_fn=
  @if cand(
        strmatch(mul(1.5,2),3),
        eq(mul(-2,3),-6),
        eq(mul(),0),
        eq(mul(foo,3),0)
      )=
  {
    @log smoke=TC002: mul decimal and coercion cases. Succeeded.
  },
  {
    @log smoke=TC002: mul decimal and coercion cases. Failed (mul(1.5%,2)=[mul(1.5,2)] mul(-2%,3)=[mul(-2,3)] mul()=[mul()] mul(foo%,3)=[mul(foo,3)]).
  }
-
#
# Test Case #3 - NearestPretty still shortens where a neighbour really
# is shorter.  Guards the opposite direction from TC003: a fix that
# simply returned the raw product would break these.
#
&tr.tc003 test_mul_fn=
  @if cand(
        strmatch(mul(1.1,1.1),1.21),
        strmatch(mul(1.5,2),3),
        strmatch(mul(0.1,3),0.3)
      )=
  {
    @log smoke=TC003: mul prettification retained. Succeeded.
  },
  {
    @log smoke=TC003: mul prettification retained. Failed (sq=[mul(1.1,1.1)] i=[mul(1.5,2)] tenth=[mul(0.1,3)]).
  }
-
#
# Test Case #4 - The two NearestPretty regimes.
#
# mul() finishes with NearestPretty(), which scans R +/- 4 ulp and takes
# the neighbour with the shortest decimal rendering.  That gives two
# distinct behaviours, and both are asserted here because a change to
# either one is a regression:
#
#   TIE      R already renders as short as the best neighbour, so R must
#            survive.  sqrt(1.5) is 16 digits and its shortest neighbour
#            is also 16, so mul(sqrt(1.5),1) must be sqrt(1.5).  A
#            tie-break preferring a lower neighbour returns
#            1.224744871391588 instead and fails here.
#
#   SHORTER  A neighbour is STRICTLY shorter, so NearestPretty moves the
#            result on purpose.  sqrt(2) is 17 digits and its neighbour
#            one ulp below is 16, so mul(sqrt(2),1) is deliberately NOT
#            sqrt(2).  Disabling NearestPretty to "fix" the tie case
#            would return 1.4142135623730951 and fail here.
#
&tr.tc004 test_mul_fn=
  @if cand(
        strmatch(mul(1.224744871391589,1),1.224744871391589),
        strmatch(mul(2.449489742783178,1),2.449489742783178),
        strmatch(mul(sqrt(1.5),1),[sqrt(1.5)]),
        strmatch(mul(sqrt(2),1),1.414213562373095)
      )=
  {
    @log smoke=TC004: mul NearestPretty tie and shorten. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC004: mul NearestPretty tie and shorten. Failed (tie1=[mul(1.224744871391589,1)] tie2=[mul(2.449489742783178,1)] tiesq=[mul(sqrt(1.5),1)]/[sqrt(1.5)] shorten=[mul(sqrt(2),1)]).;
    @trig me/tr.done
  }
-
&tr.done test_mul_fn=
  @log smoke=End mul() test cases.;
  @notify smoke
-
drop test_mul_fn
-
#
# End of Test Cases
#
