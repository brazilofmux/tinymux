#
# smoke.mux - Automated testing infrastructure.
#
# suite.list.1 / suite.list.2 / suite.expected are filled by
# tools/generate_smoke_suite.py (appended last by Makesmoke).  Do not
# hardcode the test inventory here — a second stale list made #1387
# silent when the generator's override could not match this object.
#
# Keep smoke in inventory (do not `drop` it).  Later fixtures such as
# topology_fn teleport the wizard; a dropped smoke is left behind and
# becomes unmatchable, so every subsequent `&attr smoke=...` is a no-op
# and the generator's full suite never lands (#1387).
#
@create smoke
-
@set smoke=INHERIT QUIET
-
#
# Placeholders so @startup is valid if the generator is omitted; Makesmoke
# always appends the generator which overwrites these.
#
&suite.list.1 smoke=
  shutdown
-
&suite.list.2 smoke=
-
&suite.expected smoke=
  0
-
@startup smoke=
  @log smoke=Starting SmokeMUX;
  @log smoke=SUITE-EXPECTED: [v(suite.expected)];
  @drain me;
  @dolist v(suite.list.1)=
  {
    @trig me/suite.tr=##
  };
  @dolist v(suite.list.2)=
  {
    @trig me/suite.tr=##
  };
  @notify me
-
&suite.tr smoke=
  @wait me=
  {
    @log smoke=SUITE-DISPATCH: %0 tcs=[words(lattr(test_%0/tr.tc*))];
    @dolist lattr(test_%0/tr.tc*)=@trig test_%0/##
  }
-
#
# End of smoke.mux
#
