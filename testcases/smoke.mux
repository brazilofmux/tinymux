#
# smoke.mux - Automated testing infrastructure.
#
@create smoke
-
@set smoke=INHERIT QUIET
-
# The suite lists are generated, not written here.  tools/generate_smoke_suite.py
# emits `&suite.list.1/2 smoke=...` into the upload stream after every .mux
# file, and tools/Makesmoke writes the same names to suite.manifest for the
# runner to check against.
#
# There used to be a hardcoded pair here as well.  They were not a fallback,
# they were a trap: when the generated override silently failed to apply
# (#1391), the suite quietly ran this older, shorter list and reported a
# clean result, because SUITE-EXPECTED is computed from whatever ended up
# stored.  Nothing should define these but the generator.
#
@startup smoke=
  @log smoke=Starting SmokeMUX;
  @log smoke=SUITE-EXPECTED: [add(words(v(suite.list.1)),words(v(suite.list.2)))];
  @drain me;
  @dolist v(suite.list.1)=
  {
    @trig me/suite.tr=##
  };
  @dolist v(suite.list.2)=
  {
    @trig me/suite.tr=##
  };
  @notify me
-
&suite.tr smoke=
  @wait me=
  {
    @log smoke=SUITE-DISPATCH: %0 tcs=[words(lattr(test_%0/tr.tc*))];
    @dolist lattr(test_%0/tr.tc*)=@trig test_%0/##
  }
-
# Pin `smoke` to #0 explicitly rather than dropping it wherever #1 happens
# to be standing.  Files sorting before this one can move #1 (route_fn.mux
# does), so "the upload starts in Limbo" is not a guarantee by the time we
# get here.
@tel me=#0
-
drop smoke
-
#
# End of smoke.mux
#
