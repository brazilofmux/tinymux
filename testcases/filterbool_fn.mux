#
# filterbool_fn.mux - Test Cases for filterbool().
#
# filterbool(<attr>,<list>[,<in delim>[,<out delim>[,<arg1>...]]]) keeps
# the elements of <list> for which evaluating <attr> with the element as
# %0 yields a boolean-true value.  "Boolean-true" is xlate(), not
# "atol() != 0" — a non-numeric non-empty string is true — so the
# non-numeric cases below are the ones that matter (see #1157 for the
# same distinction getting lost in the JIT).
#
@create test_filterbool_fn
-
@set test_filterbool_fn=INHERIT QUIET
-
&fn.is_odd test_filterbool_fn=mod(%0,2)
-
&fn.echo test_filterbool_fn=%0
-
&tr.tc000 test_filterbool_fn=
  @log smoke=Beginning filterbool() test cases.
-
#
# Test Case #1 - Documented example: odd numbers survive.
#
&tr.tc001 test_filterbool_fn=
  @if cand(
        strmatch(filterbool(me/fn.is_odd,1 2 3 4 5), 1 3 5),
        eq(strlen(filterbool(me/fn.is_odd,2 4 6)), 0)
      )=
  {
    @log smoke=TC001: filterbool numeric truth. Succeeded.
  },
  {
    @log smoke=TC001: filterbool numeric truth. Failed (odd=[filterbool(me/fn.is_odd,1 2 3 4 5)] none=[filterbool(me/fn.is_odd,2 4 6)]).
  }
-
#
# Test Case #2 - Boolean truth is xlate(), not a numeric test.
# "abc" is true; "0" is false.  A numeric-only truth test drops "abc".
#
&tr.tc002 test_filterbool_fn=
  @if cand(
        strmatch(filterbool(me/fn.echo,abc 0 def), abc def),
        strmatch(filterbool(me/fn.echo,1 0 2), 1 2)
      )=
  {
    @log smoke=TC002: filterbool string truth. Succeeded.
  },
  {
    @log smoke=TC002: filterbool string truth. Failed (strs=[filterbool(me/fn.echo,abc 0 def)] nums=[filterbool(me/fn.echo,1 0 2)]).
  }
-
#
# Test Case #3 - Alternate input and output delimiters.
# When only <in delim> is given the OUTPUT delimiter defaults to it, not
# to a space — matching filter() and map().  The help text does not say
# so, which is exactly why it is worth pinning.
#
&tr.tc003 test_filterbool_fn=
  @if cand(
        strmatch(filterbool(me/fn.is_odd,1|2|3,|), 1|3),
        strmatch(filterbool(me/fn.is_odd,1|2|3,|,-), 1-3)
      )=
  {
    @log smoke=TC003: filterbool delimiters. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC003: filterbool delimiters. Failed (indelim=[filterbool(me/fn.is_odd,1|2|3,|)] outdelim=[filterbool(me/fn.is_odd,1|2|3,|,-)]).;
    @trig me/tr.done
  }
-
&tr.done test_filterbool_fn=
  @log smoke=End filterbool() test cases.;
  @notify smoke
-
drop test_filterbool_fn
-
#
# End of Test Cases
#
