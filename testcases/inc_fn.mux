#
# inc_fn.mux - Test Cases for inc().
#
@create test_inc_fn
-
@set test_inc_fn=INHERIT QUIET
-
#
# Beginning of Test Cases
#
&tr.tc000 test_inc_fn=
  @log smoke=Beginning inc() test cases.
-
#
# Test Case #1 - Basic increment operations.
#
&tr.tc001 test_inc_fn=
  @if cand(
        eq(inc(5), 6),
        eq(inc(0), 1),
        eq(inc(-3), -2)
      )=
  {
    @log smoke=TC001: inc basic operations. Succeeded.
  },
  {
    @log smoke=TC001: inc basic operations. Failed (inc(5)=[inc(5)] inc(0)=[inc(0)] inc(-3)=[inc(-3)]).;
  }
-
#
# Test Case #2 - Decimal and coercion cases.
#
&tr.tc002 test_inc_fn=
  @if cand(
        eq(inc(1.5),2),
        eq(inc(-0.5),1),
        eq(inc(),1),
        eq(inc(foo),1)
      )=
  {
    @log smoke=TC002: inc decimal and coercion cases. Succeeded.
  },
  {
    @log smoke=TC002: inc decimal and coercion cases. Failed (inc(1.5)=[inc(1.5)] inc(-0.5)=[inc(-0.5)] inc()=[inc()] inc(foo)=[inc(foo)]).
  }
-
#
# Test Case #3 - 64-bit boundary (#1472).  inc() wraps at INT64_MAX rather
# than saturating or erroring.  That wrap is the historical behavior and is
# pinned here; the fix for #1472 removed the signed overflow that produced
# it without changing the value.
#
&tr.tc003 test_inc_fn=
  @if cand(
        eq(inc(9223372036854775807), -9223372036854775808),
        eq(inc(-9223372036854775808), -9223372036854775807),
        eq(inc(-1), 0),
        eq(inc(9223372036854775806), 9223372036854775807)
      )=
  {
    @log smoke=TC003: inc 64-bit boundary wrap. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC003: inc 64-bit boundary wrap. Failed (inc(max)=[inc(9223372036854775807)] inc(min)=[inc(-9223372036854775808)] inc(-1)=[inc(-1)] inc(max-1)=[inc(9223372036854775806)]).;
    @trig me/tr.done
  }
-
&tr.done test_inc_fn=
  @log smoke=End inc() test cases.;
  @notify smoke
-
drop test_inc_fn
-
#
# End of Test Cases
#
