#
# jit_route_parity_fn.mux - Parity tests across evaluation routes.
#
# These tests compare the same expression through two routes:
#   1. normal evaluation (the JIT route — jit_eval_brackets defaults on)
#   2. a stored attribute triggered as a command, which exercises
#      command-argument expansion from an attribute body
# The former asteval({...}) leg was dropped: the dual-toggle smoke
# runs already check both evaluation routes against these comparisons,
# and asteval's bracket-content pre-evaluation footgun (#987) makes
# the inline pattern easy to misuse.
#
@create test_jit_route_parity_fn
-
@set test_jit_route_parity_fn=INHERIT QUIET
-
#
# Helper attributes. Each one stores the routed result in tcNNN_result.
#
&tr.helper1 test_jit_route_parity_fn=
  &tc001_result me=[cand(eq(dist2d(0,0,3,4),5),eq(mean(2,4,6),4),eq(median(3,1,2),2))]
-
&tr.helper2 test_jit_route_parity_fn=
  &tc002_result me=[cand(strmatch(round(sqrt(2),6),1.414214),eq(round(2.5,0),2),strmatch(cat(dist3d(0,0,0,1,2,2)),3))]
-
&tr.helper3 test_jit_route_parity_fn=
  &tc003_result me=[elements(%bAck%b%bMoo%bBeep%bFoof,2,2)]
-
&tr.helper4 test_jit_route_parity_fn=
  &tc004_result me=[insert(Yet@Another@Funky@List,Mundane,4,@)]
-
&tr.helper5 test_jit_route_parity_fn=
  &tc005_result me=[switch(a,a,{result,with,commas},*,other)]
-
&tr.helper6 test_jit_route_parity_fn=
  &tc006_result me=[cand(eq(member(c,a b c d),3),strmatch(remove(b,a|b|c,|),a|c),strmatch(insert(a|c,x,2,|),a|x|c))]
-

&tr.helper7 test_jit_route_parity_fn=
  &tc007_result me=[eval(\[add(1,2)\]\[add(2,2)\]\[mul(2,3)\])]
-

&tr.helper8 test_jit_route_parity_fn=
  &tc008_result me=[cat(%q0,-,[add(1,2)],-,%0)]
-
#
# Beginning of Test Cases
#
&tr.tc000 test_jit_route_parity_fn=
  @log smoke=Beginning JIT route parity test cases.
-
#
# Test Case #1 - float-producing compare chains survive command route replay.
#
&tr.tc001 test_jit_route_parity_fn=
  &tc001_result me=;
  @trig/now me/tr.helper1;
  @if strmatch(
        setr(0,sha1([cand(eq(dist2d(0,0,3,4),5),eq(mean(2,4,6),4),eq(median(3,1,2),2))])),
        sha1([get(me/tc001_result)])
      )=
  {
    @log smoke=TC001: float compare chain route parity. Succeeded.
  },
  {
    @log smoke=TC001: float compare chain route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #2 - float formatting inside boolean composition matches all routes.
#
&tr.tc002 test_jit_route_parity_fn=
  &tc002_result me=;
  @trig/now me/tr.helper2;
  @if strmatch(
        setr(0,sha1([cand(strmatch(round(sqrt(2),6),1.414214),eq(round(2.5,0),2),strmatch(cat(dist3d(0,0,0,1,2,2)),3))])),
        sha1([get(me/tc002_result)])
      )=
  {
    @log smoke=TC002: float formatting route parity. Succeeded.
  },
  {
    @log smoke=TC002: float formatting route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #3 - whitespace-sensitive list extraction matches all routes.
#
&tr.tc003 test_jit_route_parity_fn=
  &tc003_result me=;
  @trig/now me/tr.helper3;
  @if strmatch(
        setr(0,sha1([elements(%bAck%b%bMoo%bBeep%bFoof,2,2)])),
        sha1([get(me/tc003_result)])
      )=
  {
    @log smoke=TC003: elements() whitespace route parity. Succeeded.
  },
  {
    @log smoke=TC003: elements() whitespace route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #4 - explicit-delimiter list insertion matches all routes.
#
&tr.tc004 test_jit_route_parity_fn=
  &tc004_result me=;
  @trig/now me/tr.helper4;
  @if strmatch(
        setr(0,sha1([insert(Yet@Another@Funky@List,Mundane,4,@)])),
        sha1([get(me/tc004_result)])
      )=
  {
    @log smoke=TC004: insert() delimiter route parity. Succeeded.
  },
  {
    @log smoke=TC004: insert() delimiter route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #5 - brace-protected commas match all routes.
#
&tr.tc005 test_jit_route_parity_fn=
  &tc005_result me=;
  @trig/now me/tr.helper5;
  @if strmatch(
        setr(0,sha1([switch(a,a,{result,with,commas},*,other)])),
        sha1([get(me/tc005_result)])
      )=
  {
    @log smoke=TC005: brace comma route parity. Succeeded.
  },
  {
    @log smoke=TC005: brace comma route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #6 - mixed list operators inside cand() match all routes.
#
&tr.tc006 test_jit_route_parity_fn=
  &tc006_result me=;
  @trig/now me/tr.helper6;
  @if strmatch(
        setr(0,sha1([cand(eq(member(c,a b c d),3),strmatch(remove(b,a|b|c,|),a|c),strmatch(insert(a|c,x,2,|),a|x|c))])),
        sha1([get(me/tc006_result)])
      )=
  {
    @log smoke=TC006: mixed list route parity. Succeeded.
  },
  {
    @log smoke=TC006: mixed list route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #7 - escaped eval brackets survive the trigger command route.
#
&tr.tc007 test_jit_route_parity_fn=
  &tc007_result me=;
  @trig/now me/tr.helper7;
  @if strmatch(
        setr(0,sha1([eval(\[add(1,2)\]\[add(2,2)\]\[mul(2,3)\])])),
        sha1([get(me/tc007_result)])
      )=
  {
    @log smoke=TC007: escaped eval bracket route parity. Succeeded.
  },
  {
    @log smoke=TC007: escaped eval bracket route parity. Failed (norm=%q0 route=[sha1(get(me/tc001_result))]).
  }
-
#
# Test Case #8 - q-registers survive stored-attribute command expansion.
#
&tr.tc008 test_jit_route_parity_fn=
  setr(0,kiwi);
  &tc008_result me=;
  @trig/now me/tr.helper8=pear;
  @if strmatch(
        setr(1,sha1([cat(%q0,-,[add(1,2)],-,pear)])),
        sha1([get(me/tc008_result)])
      )=
  {
    @log smoke=TC008: q-register route parity. Succeeded.
  },
  {
    @log smoke=TC008: q-register route parity. Failed (norm=%q1).
  }
-
#
# Test Case #9 - runtime-arg float arithmetic via u()/cargs through the
# Tier 2 blob wrappers (#778).  u() runs the attribute body through the
# JIT-compiled program, so mul/fdiv/sub/sqrt with non-constant (carg)
# operands take the blob's float path (rv64_strtod/rv64_fval intrinsics).
# A regression here returns empty instead of the product/quotient.
# (ulambda() also routes through mux_exec/the JIT since #718; its blob
# float coverage lives in lambda_fn.mux TC011.)
#
&fn.mul test_jit_route_parity_fn=mul(%0,%1)
-
&fn.fdiv test_jit_route_parity_fn=fdiv(%0,%1)
-
&fn.sub test_jit_route_parity_fn=sub(%0,%1)
-
&fn.sqrt test_jit_route_parity_fn=sqrt(%0)
-
&tr.tc009 test_jit_route_parity_fn=
  @if cand(
        strmatch(u(me/fn.mul,6,7),42),
        strmatch(u(me/fn.fdiv,20,8),2.5),
        strmatch(u(me/fn.sub,3.5,1.25),2.25),
        strmatch(u(me/fn.sqrt,16),4),
        strmatch(u(me/fn.mul,2.5,4),10)
      )=
  {
    @log smoke=TC009: u()/cargs float math via blob. Succeeded.
  },
  {
    @log smoke=TC009: u()/cargs float math via blob. Failed (mul=[u(me/fn.mul,6,7)] fdiv=[u(me/fn.fdiv,20,8)] sub=[u(me/fn.sub,3.5,1.25)] sqrt=[u(me/fn.sqrt,16)] mulf=[u(me/fn.mul,2.5,4)]).
  }
-
#
# Test Case #10 - a denied u() stays denied on EVERY route (#2092).
#
# The JIT inlines u() only when the first argument is a LITERAL #dbref.
# The spelling is therefore the whole test: u(me/attr) and u([num(#1)]/attr)
# never reach the inline gate, u(#1/attr) does.
#
# #2092 was a reversed branch that sent DENIED calls into the inline arm, so
# a no_eval attribute had its body evaluated anyway on the compiled route
# while the interpreter route correctly returned the text.  The corpus missed
# it for one reason: its only denial coverage (lambda_fn TC012) spells its
# target me/attr, the one form the gate ignores.
#
# #1 is the target because the gate needs a literal dbref and the test
# object's number is not known when this file is written.  Verified to have
# teeth: with #2092 reverted, the literal leg returns 5 while the indirect
# leg returns the text, so both the shape assertions and the agreement
# assertion fail.
#
# The fn.plain leg is a positive control.  Without it this case would still
# pass if the inline were disabled outright, which would make it blind to
# exactly the path it exists to cover.
#
&fn.noev #1=add(%0,%1)
-
&fn.plain #1=add(%0,%1)
-
@set #1/fn.noev=no_eval
-
&tr.tc010 test_jit_route_parity_fn=
  @if cand(
        strmatch(u(#1/fn.noev,2,3), add\(*\)),
        strmatch(u([num(#1)]/fn.noev,2,3), add\(*\)),
        strmatch(u(#1/fn.noev,2,3), u([num(#1)]/fn.noev,2,3)),
        strmatch(u(#1/fn.plain,2,3), 5)
      )=
  {
    @log smoke=TC010: denied u() parity across routes. Succeeded.
  },
  {
    @log smoke=TC010: denied u() parity across routes. Failed (lit=[u(#1/fn.noev,2,3)] ind=[u([num(#1)]/fn.noev,2,3)] plain=[u(#1/fn.plain,2,3)]).
  }
-
#
# Test Case #11 - a TRACE'd attribute stays correct on every route (#2098).
#
# The u()-inline has no channel for AttrTrace/EV_TRACE side-channel
# lines, so AF_TRACE is a compile-time decline (same gate MAP carries)
# and a runtime decline in _CHECK_U_PERM.  Both force the fun_u ECALL,
# which is the path that can emit traces.
#
# Smoke cannot cleanly assert that the trace LINES appear (they go to
# the executor's notify path, not the smoke log), so this case pins
# the result: TRACE must not change the value, and the literal-dbref
# form (inline-eligible spelling) must agree with the indirect form
# (never inlined).  A regression that silently inlined and then
# mishandled the body would fail the agreement or the value.
#
# fn.plain is the untraced control: if TRACE somehow broke all
# literal-dbref u() calls, plain would fail with them and the case
# would still name the wrong cause.
#
&fn.traced #1=add(%0,%1)
-
@set #1/fn.traced=trace
-
&tr.tc011 test_jit_route_parity_fn=
  @if cand(
        strmatch(u(#1/fn.traced,2,3), 5),
        strmatch(u([num(#1)]/fn.traced,2,3), 5),
        strmatch(u(#1/fn.traced,2,3), u([num(#1)]/fn.traced,2,3)),
        strmatch(u(#1/fn.plain,2,3), 5)
      )=
  {
    @log smoke=TC011: TRACE'd u() parity across routes. Succeeded.;
    @trig me/tr.tc012
  },
  {
    @log smoke=TC011: TRACE'd u() parity across routes. Failed (lit=[u(#1/fn.traced,2,3)] ind=[u([num(#1)]/fn.traced,2,3)] plain=[u(#1/fn.plain,2,3)]).;
    @trig me/tr.tc012
  }
-
#
# Test Case #12 - an inlined u() body runs in the TARGET's executor
# context (#2179).
#
# fun_u evaluates the attribute body with executor = the object holding
# the attribute; the Tier 3 inline compiled the body into the CALLER's
# program without that swap, so %!, v(), bare-name u(), and name(me)
# inside u(#obj/attr) all resolved against the caller.  This trigger
# runs as the test object, so caller != target (#1) and the
# discrimination is live: the broken inline returned the test object's
# dbref for %! and empty for v()/bare-u() (the attrs live on #1, not
# here).  The last leg asserts %! is RESTORED after the call — a push
# without its pop would leave the whole rest of the evaluation running
# as #1.
#
# The [num(#1)] spelling never reaches the inline gate (TC010's
# convention) and is the interpreter oracle for the same body.
#
&fn.exec #1=%!:[v(fn.execdata)]:[u(fn.execbare)]:[name(me)]
-
&fn.execdata #1=DATA
-
&fn.execbare #1=BARE
-
&tr.tc012 test_jit_route_parity_fn=
  @if cand(
        strmatch(u(#1/fn.exec), u([num(#1)]/fn.exec)),
        strmatch(u(#1/fn.exec), #1:DATA:BARE:*),
        strmatch(strcat(u(#1/fn.exec),|,%!), #1:DATA:BARE:*|[num(me)])
      )=
  {
    @log smoke=TC012: inlined u() executor context. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC012: inlined u() executor context. Failed (lit=[u(#1/fn.exec)] ind=[u([num(#1)]/fn.exec)] after=%!).;
    @trig me/tr.done
  }
-
&tr.done test_jit_route_parity_fn=
  @log smoke=End JIT route parity test cases.;
  @notify smoke
-
drop test_jit_route_parity_fn
-
