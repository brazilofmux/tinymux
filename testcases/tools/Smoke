#!/bin/sh
#
#	Smoke - Kick off the automated testing process.  Don't use this unless
#	        you know what you're doing.  It may eat your database.
#
PATH=/usr/ucb:/bin:/usr/bin:.:$PATH; export PATH
#
#	Verify that file dependencies are in a pristine state.
#
GAMENAME=smoke
PIDFILE=$GAMENAME.pid
BIN=../mux/game/bin
PORT=${SMOKE_PORT:-2860}
TEXT=./text
DATA=./$GAMENAME.d
LOGDIR=$DATA
NEW_DB=$GAMENAME.db.new
INPUT_DB=$GAMENAME.db
GDBM_DB=$GAMENAME
CRASH_DB=$GAMENAME.db.CRASH
SAVE_DB=$GAMENAME.db.old
#
#	Verify that temporary game directory does not already exist.
#
if [ -r $DATA ]; then
	echo "$DATA directory already exists."
	exit 1
fi
#
#	Make sure the smoke test isn't already running.
#
if [ -r "$PIDFILE" ]; then
    oldpid=`cat $PIDFILE`
    if [ "$oldpid" -gt 1 ]; then
        nmux=`ps | grep $oldpid | grep netmux | wc -l`
        if [ "$nmux" -gt 0 ]; then
            echo "A smoke test already seems to be running."
            exit 0
        fi
    fi
fi
#
#	Create necessary environment.
#
echo "Creating $DATA directory."
mkdir $DATA
if [ ! -r logs ]; then
    echo "Creating ./logs directory."
    mkdir logs
fi
if [ ! -r text ]; then
    echo "Creating ./text directory."
    mkdir text
fi
if [ ! -r bin ]; then
    ln -s $BIN bin
fi
cp smoke.flat $DATA/$INPUT_DB
cp ../mux/game/alias.conf .
cp ../mux/game/compat.conf .
touch logs/M-smoke.log
cat > smoke.conf <<_EOF
# smoke.conf - TinyMUX configuration file for smoke testing.
#
input_database	smoke.d/smoke.db
output_database	smoke.d/smoke.db.new
crash_database	smoke.d/smoke.db.CRASH
#
# Mail, comsystem, and macro databases.
#
mail_database   smoke.d/mail.db
comsys_database smoke.d/comsys.db
#
port $PORT
mud_name SmokeMUX
#
command_quota_increment 10000
command_quota_max 10000
player_queue_limit 100000
#
include alias.conf
include compat.conf
_EOF
#
#	Kick off MUX
#

# Linux/Solaris
LD_LIBRARY_PATH=$BIN
export LD_LIBRARY_PATH

# Mac OS X / NeXTStep / Mach
DYLD_LIBRARY_PATH=$BIN
export DYLD_LIBRARY_PATH

# AIX
LIBPATH=$BIN
export LIBPATH

# HP-UX
SHLIB_PATH=$BIN
export SHLIB_PATH

$BIN/netmux -c $GAMENAME.conf -p $PIDFILE -e $LOGDIR >/dev/null 2>&1

#
#	Wait for MUX to finish shutdown.
#
waited=0
while [ -r "$PIDFILE" ] && kill -0 `cat $PIDFILE 2>/dev/null` 2>/dev/null; do
    sleep 1
    waited=`expr $waited + 1`
    if [ "$waited" -ge 120 ]; then
        echo "MUX process still running after ${waited}s."
        exit 1
    fi
done
sleep 1

#
#	Grab resulting log file and clean up.
#
if [ ! -r logs/M-smoke.log ]; then
    echo "The server produced no log; the suite did not run."
    exit 1
fi
mv logs/M-smoke.log smoke.log
rm smoke.conf
rm $PIDFILE
rm shutdown.status
echo "Deleting $DATA, logs, and text directories."
rm -rf $DATA ./logs ./text
rm alias.conf
rm compat.conf
rm -f bin

#
#	Report the outcome and exit accordingly.
#
#	The result used to live only inside smoke.log, and reading it was left
#	to whoever thought to grep.  A standing failure then looks exactly like
#	a clean run: the stale hash in #2261 failed every Unicode build for six
#	months and everybody read 347/1 as normal.
#
#	No results at all is a failure too, not a pass -- that is the shape of
#	#2247 and #2270, where the harness reported success for work it never
#	did.  Comparing against an expected total would catch more of that, but
#	there is no manifest to compare against yet.
#
nSucceeded=`grep -c 'Succeeded\.' smoke.log 2>/dev/null`
nFailed=`grep -c 'Failed' smoke.log 2>/dev/null`
echo "$nSucceeded Succeeded, $nFailed Failed."
if [ "$nFailed" -ne 0 ]; then
    grep 'Failed' smoke.log | sed 's/^/    /'
    exit 1
fi
if [ "$nSucceeded" -eq 0 ]; then
    echo "No test results in smoke.log; the database produced nothing to run."
    exit 1
fi
exit 0
