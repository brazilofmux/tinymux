# jitstats_fn.mux - Test Cases for jitstats().
#
@create test_jitstats_fn
-
@set test_jitstats_fn=INHERIT QUIET
-
&tr.has_jit test_jitstats_fn=
  [strmatch(jitstats(),*eval_attempts=*)]
-
&LJ_ADD test_jitstats_fn=return mux.args[1] + mux.args[2]
-
&tr.has_lua test_jitstats_fn=
  [strmatch(lua(me/LJ_ADD,2,3),5)]
-
&tr.lj_ok test_jitstats_fn=
  [after(grab(jitstats(),lua_run_ok=*),=)]
-
&tr.lj_try test_jitstats_fn=
  [add(after(grab(jitstats(),lua_run_ok=*),=),after(grab(jitstats(),lua_run_fail=*),=))]
-
&tr.tc001 test_jitstats_fn=
  @if u(me/tr.has_jit)=
  {
    @if strmatch(
          setr(0,jitstats()),
          *eval_attempts=*eval_handled=*
        )=
    {
      @log smoke=TC001: jitstats returns counters. Succeeded.
    },
    {
      @log smoke=TC001: jitstats returns counters. Failed (%q0).
    }
  },
  {
    @log smoke=TC001: jitstats returns counters. Skipped (JIT not enabled).
  }
-
&tr.tc002 test_jitstats_fn=
  @if u(me/tr.has_jit)=
  {
    @if strmatch(
          setr(0,jitstats()),
          *bail_noeval=*bail_slots=*
        )=
    {
      @log smoke=TC002: jitstats has bailout counters. Succeeded.
    },
    {
      @log smoke=TC002: jitstats has bailout counters. Failed (%q0).
    }
  },
  {
    @log smoke=TC002: jitstats has bailout counters. Skipped (JIT not enabled).
  }
-
&tr.tc003 test_jitstats_fn=
  @if u(me/tr.has_jit)=
  {
    @if strmatch(
          setr(0,jitstats(reset)),
          OK
        )=
    {
      @log smoke=TC003: jitstats reset. Succeeded.
    },
    {
      @log smoke=TC003: jitstats reset. Failed (%q0).
    }
  },
  {
    @log smoke=TC003: jitstats reset. Skipped (JIT not enabled).
  }
-
#
# Test Case #4 - The Lua JIT engages when lua_jit is on, and stays out of
# the way when it is off (#1324).
#
# Green smoke does not prove the compiled Lua path ran: every Lua JIT
# failure falls back to the Lua interpreter and still returns the correct
# answer, so a test that only checks lua()'s result passes whether or not
# the JIT did anything (#1249, #1278).  lua_run_ok is what distinguishes
# them, which is why it is reported by jitstats() (#1316).
#
# Asserted in BOTH directions rather than skipped under the default, so
# neither mode is vacuous: with lua_jit 1 the Lua JIT must be reached, with
# lua_jit 0 it must not be -- that second half is a real test of the gate
# added in #1310.
#
# What "reached" means, and why it is not simply lua_run_ok advancing:
# run_cached_program refuses re-entry while an outer softcode program is
# live (#1321), so a lua() called from JIT-compiled softcode declines to
# the Lua interpreter by design (#1326).  With jit_eval_brackets on -- the
# default, and what the smoke suite runs under -- that is every lua() call
# here, so run_ok can never advance and requiring it would fail on every
# platform.  Requiring run_ok + run_fail to advance instead still proves
# the compiled path was entered and a program was produced, which is the
# #1278 blindness this case exists to remove, and the log line records
# which of the two outcomes occurred so the distinction is not lost.
#
# Tighten this to require run_ok once #1326 lifts the nesting restriction.
#
# Counters are sampled before and after rather than compared against zero,
# so the case does not depend on where it falls in the suite or on whether
# TC003's reset ran first.  Note it must NOT require lua_compile_ok to
# advance: tr.has_lua above compiles the chunk, so the measured call is a
# cache hit and compiles nothing.
#
&tr.tc004 test_jitstats_fn=
  @if cand(u(me/tr.has_jit),u(me/tr.has_lua))=
  {
    @if strmatch(
          setr(3,[null(setr(0,u(me/tr.lj_try)))][null(setr(4,u(me/tr.lj_ok)))][lua(me/LJ_ADD,2,3)][null(setr(1,u(me/tr.lj_try)))][null(setr(5,u(me/tr.lj_ok)))]),
          5
        )=
    {
      @if strmatch(config(lua_jit),1)=
      {
        @if gt(%q1,%q0)=
        {
          @if gt(%q5,%q4)=
          {
            @log smoke=TC004: lua JIT engages under lua_jit 1. Succeeded (ran, lua_run_ok %q4 to %q5).;
            @trig me/tr.done
          },
          {
            @log smoke=TC004: lua JIT engages under lua_jit 1. Succeeded (reached, declined to the Lua interpreter per #1326; attempts %q0 to %q1, lua_run_ok flat at %q4).;
            @trig me/tr.done
          }
        },
        {
          @log smoke=TC004: lua JIT engages under lua_jit 1. Failed (never attempted: lua_run_ok+lua_run_fail flat at %q0, compile_ok=[after(grab(jitstats(),lua_compile_ok=*),=)]).;
          @trig me/tr.done
        }
      },
      {
        @if strmatch(%q0,%q1)=
        {
          @log smoke=TC004: lua JIT stays out under lua_jit 0. Succeeded.;
          @trig me/tr.done
        },
        {
          @log smoke=TC004: lua JIT stays out under lua_jit 0. Failed (attempted: %q0 to %q1 with lua_jit 0).;
          @trig me/tr.done
        }
      }
    },
    {
      @log smoke=TC004: lua JIT engage. Failed (lua returned %q3, expected 5).;
      @trig me/tr.done
    }
  },
  {
    @log smoke=TC004: lua JIT engage. Skipped (JIT or Lua not available).;
    @trig me/tr.done
  }
-
&tr.fl_nested test_jitstats_fn=
  [jitstats(flush)]
-
#
# Test Case #5 - jitstats(flush) survives being called from inside a
# compiled program (#1316).
#
# The flush clears the in-memory program caches, and softcode reaches
# this function through an ECALL from compiled code -- so the call can
# arrive with a live compiled_program on the stack, and clearing frees
# the program that is still executing.  It surfaced as an empty return
# instead of OK on the JIT route, because the post-run harvest reads
# prog->out_addr out of memory that had just been released.
#
# The captures below must be real top-level eval-bracket regions.  The
# same call written inline inside cand(...) sits in a function argument
# and is not necessarily the compiled region, so it would not reproduce
# the defect.  f.nested goes one further and reaches the flush through
# u(...), which is the ECALL path itself.
#
# f.iter leads because it is the only shape that discriminates on every
# host (#1413).  The defect is a use-after-free, so what the harvest reads
# out of the freed compiled_program depends on the allocator: on macOS
# arm64 the direct shape returns empty, but on Linux x86-64 the freed bytes
# are still usable and it returns OK against the UNFIXED engine -- so a test
# built only on the direct shape passes there and guards nothing.  Under
# iter the whole command is lost on Linux, producing no output at all, which
# is why strlen is asserted alongside the value: the failure mode there is a
# vanished result rather than a wrong one.
#
# The general lesson, since this was the second such test in a day: a
# regression test written against the symptom you happened to observe is
# only as portable as that symptom.  Where a defect is real everywhere but
# manifests differently, pick the shape with the widest failure, not the one
# that was easiest to see.
#
# The counter check is the other half: a return of OK proves nothing if
# the flush stopped flushing.  f.s1 and f.s2 evaluate identical text, so
# the second would be a memory-cache hit had the cache survived; after a
# real flush every region after it misses, and cache_hit_mem is unmoved.
#
# No tr.done handoff here.  The @dolist over tr.tc* queues this case
# after tc004, and tc004's tr.done trigger is queued after that again,
# so tr.done still runs last.  Triggering tr.tc005 from tc004 instead
# would run this case twice, since the dolist already dispatches it.
#
&tr.tc005 test_jitstats_fn=
  @if u(me/tr.has_jit)=
  {
    &f.iter me=[iter(1 2 3,[u(me/tr.fl_nested)]-)];
    &f.direct me=[jitstats(flush)];
    &f.nested me=[u(me/tr.fl_nested) tailmark];
    &f.s1 me=[jitstats()];
    &f.warm me=[jitstats(flush)];
    &f.s2 me=[jitstats()];
    @if cand(
          strmatch(v(f.iter),OK- OK- OK-),
          gt(strlen(v(f.iter)),0),
          strmatch(v(f.direct),OK),
          strmatch(v(f.nested),OK tailmark),
          strmatch(v(f.warm),OK),
          eq(after(grab(v(f.s1),cache_hit_mem=*),=),
             after(grab(v(f.s2),cache_hit_mem=*),=))
        )=
    {
      @log smoke=TC005: jitstats flush from compiled code. Succeeded.
    },
    {
      @log smoke=TC005: jitstats flush from compiled code. Failed (iter=[v(f.iter)] iterlen=[strlen(v(f.iter))] direct=[v(f.direct)] nested=[v(f.nested)] warm=[v(f.warm)] hit1=[after(grab(v(f.s1),cache_hit_mem=*),=)] hit2=[after(grab(v(f.s2),cache_hit_mem=*),=)]).
    }
  },
  {
    @log smoke=TC005: jitstats flush from compiled code. Skipped (JIT not enabled).
  }
-
#
# Test Case #6 - the Lua JIT actually EXECUTES compiled code (#1426).
#
# TC004 asserts on attempts (lua_run_ok + lua_run_fail), and a declined run
# increments lua_run_fail, so it passes whether the compiled path ran or
# refused to.  Worse, under the suite's own config lua_jit is off -- neither
# smoke.conf sets it -- so TC004 takes its "stays out under lua_jit 0" branch
# and the compiled Lua path is never exercised at all.  lua_run_ok is the
# only counter that proves compiled Lua executed.
#
# Two config changes are needed and both are server-wide, so (like TC019 in
# jit_parity_fn.mux and nested_depth.mux) the juggling happens in SETUP: at
# Makesmoke bake time, as #1, storing results in attributes for the case to
# assert.  Doing it at run time would toggle globals under every other test
# in the suite.
#
#   lua_jit 1           - otherwise nothing is compiled at all.
#   jit_eval_brackets 0 - fun_lua is ECALLed from inside a DBT program, and
#                         the #1326 reentrancy guard then declines every run.
#                         With brackets off the guard does not fire.
#
# Both are restored via the #$ idiom, so a failure here cannot leave the
# rest of the suite running under a different configuration.
#
# This is the signal that turns red if the Lua JIT silently goes back
# offline, and the one that will turn green on its own once #1326 is lifted
# and the brackets-0 workaround can be dropped.
#
# The restore is checked against POST_*, captured here, rather than against
# config() read in tr.tc006.  This block runs during the Makesmoke UPLOAD,
# where jit_eval_brackets is at its built-in default of 1; tr.tc006 runs
# later during Smoke, and the interpreted pass runs with it at 0.  Comparing
# across those two epochs failed on that route only and took `make test`
# red (#1437).  Both values now come from the same epoch, which is what the
# assertion is actually about: that this block put back what it changed.
#
# The exercise has to stay here rather than move into tr.tc006 -- @admin in
# a triggered attribute body does not take effect before the [lua(...)] in
# the same command list, so the chunk would run with lua_jit still 0 and
# lua_run_ok would never advance.
#
@switch [config(lua_jit)]=*,
  {
    &PRE_LUA_JIT test_jitstats_fn=#$;
    @switch [config(jit_eval_brackets)]=*,
      {
        &PRE_BRACKETS test_jitstats_fn=#$;
        @admin lua_jit=1;
        @admin jit_eval_brackets=0;
        &LJ_OK_BEFORE test_jitstats_fn=[u(test_jitstats_fn/tr.lj_ok)];
        &LJ_RESULT test_jitstats_fn=[lua(test_jitstats_fn/LJ_ADD,2,3)];
        &LJ_OK_AFTER test_jitstats_fn=[u(test_jitstats_fn/tr.lj_ok)];
        @admin jit_eval_brackets=#$;
        &POST_BRACKETS test_jitstats_fn=[config(jit_eval_brackets)]
      };
    @admin lua_jit=#$;
    &POST_LUA_JIT test_jitstats_fn=[config(lua_jit)]
  }
-
&tr.tc006 test_jitstats_fn=
  @if cand(u(me/tr.has_jit),u(me/tr.has_lua))=
  {
    @if cand(
          strmatch(get(me/LJ_RESULT),5),
          gt(get(me/LJ_OK_AFTER),get(me/LJ_OK_BEFORE)),
          strmatch(get(me/POST_LUA_JIT),get(me/PRE_LUA_JIT)),
          strmatch(get(me/POST_BRACKETS),get(me/PRE_BRACKETS))
        )=
    {
      @log smoke=TC006: lua JIT executes compiled code. Succeeded (lua_run_ok [get(me/LJ_OK_BEFORE)] to [get(me/LJ_OK_AFTER)]).
    },
    {
      @log smoke=TC006: lua JIT executes compiled code. Failed (result=[get(me/LJ_RESULT)] lua_run_ok [get(me/LJ_OK_BEFORE)] to [get(me/LJ_OK_AFTER)] lua_jit=[get(me/POST_LUA_JIT)]/[get(me/PRE_LUA_JIT)] brackets=[get(me/POST_BRACKETS)]/[get(me/PRE_BRACKETS)]).
    }
  },
  {
    @log smoke=TC006: lua JIT executes compiled code. Skipped (JIT or Lua not available).
  }
-
&t7.kv test_jitstats_fn=
  [after(grab(%0,%1=*),=)]
-
&t7.probe test_jitstats_fn=
  [strlen(get(me/t7.in))]
-
#
# Test Case #7 - jitstats sees Tier 2 and ECALL activity in NESTED evals
# (#1929, fixed in #1938).
#
# The counters are the only instrument we have for asking whether Tier 2
# engages, and #1929 opened on the reading they gave: strlen(), lcstr(),
# words(), setunion() all reported tier2=0, which looked like the generic
# lowering path being dead or gated off under muxscript.  It was neither.
# Two separate measurement artifacts produced those zeros.
#
# The first was constant folding: strlen(abcdef) is folded by try_fold in
# hir_lower.cpp and returns before tier2_lookup is ever consulted, so a
# probe written with literal arguments can never show Tier 2 no matter what
# the blob does.  That half needs no regression test -- it is the folder
# working, and folded= already reports it.
#
# The second is what this case guards.  jit_eval returns from the
# s_jit_depth > 1 shared-heap branch before ecall_total and tier2_total
# accumulate, so every nested evaluation was invisible to jitstats.  Field
# softcode reaches almost everything through u(), which means the blind spot
# covered the normal path, not an edge case -- the probe table that opened
# #1929 ran through u() and was therefore measuring nesting rather than
# dispatch.  Confirmed independently on x64/MSVC and arm64/Apple clang before
# the cause was agreed.
#
# Both levels are asserted, so neither half is vacuous.  The top-level pair
# is the control: if it does not move, the probe is wrong (folded, bailed,
# or the blob is absent) and the nested assertion below would be measuring
# nothing.  The nested pair is the guard.
#
# The probe is strlen(get(...)), one expression exercising both counters:
# GET is not on the Tier 2 allowlist so it lowers to an ECALL, STRLEN is on
# it so it takes the blob.  The argument arrives through get() rather than
# as a literal, which is what keeps try_fold out of the way.
#
# On the ECALL delta, note the threshold is 2 and not 0.  Two ECALLs in the
# window are sampling overhead, always counted even against the unfixed
# engine: the depth-1 region [u(me/t7.probe)] contains the u() call itself,
# and the PREVIOUS sample's own [jitstats()] region accumulates its one
# ECALL only after that sample's value was captured, so it lands in this
# window instead.  Anything above those two can only have come from inside
# the nested region.  Measured on both sides of the #1938 fix: the fixed
# engine's delta is 3 (overhead + the nested GET), the unfixed engine's is
# exactly 2, so gt(delta,2) discriminates.  The tier2 delta needs no such
# allowance -- jitstats() and u() contribute none -- so it is +1 fixed and
# flat unfixed.
#
# Counters are sampled into attributes first and parsed afterwards, as in
# TC005: grab/after are themselves evaluated, so parsing between the samples
# would fold the measurement apparatus into the measurement.
#
# Skipped when jit_eval_brackets is 0.  With brackets off the inner region is
# not a compiled eval region and never reaches depth 2 through the JIT at
# all, so the deltas would be zero against a correct engine -- the #1437
# shape, where a case written under one epoch's configuration goes red on the
# pass that runs under another.
#
# The nested probe is wrapped in add(...,0) deliberately (#2086).
#
# A bare [u(me/t7.probe)] no longer reaches depth 2: u() lowers to a single
# ECALL with nothing computed around it, so the compiled program does no work
# and #2086 declines it rather than paying guest entry to make the same host
# call.  The AST evaluator then calls fun_u, which re-enters mux_exec at depth
# 1 -- measurably faster (0.637 -> 0.607 us/call), but it means the wrapper
# never exercises the depth-2 shared-heap path this case exists to cover.
#
# add(u(...),0) gives the OUTER expression real work, so it compiles, and its
# ECALL to u() re-enters at depth 2 exactly as before.  Confirmed by the tier 2
# delta, which the rewrap restored from 1 back to 2.
#
# The ecalls threshold also drops from >2 to >1, and that half IS a
# recalibration rather than restored coverage, so it is worth being explicit:
# the chain used to contain three counted ECALLs and now contains two, because
# one of them was the no-work wrapper #2086 stopped running.  >1 still requires
# BOTH the u() ECALL and the depth-2 inner ECALL, so the case still fails if
# nested activity stops being counted -- which is the property it exists for.
# It is not lowered to >0, which would pass on the outer call alone and be
# vacuous for a case about NESTED evals.
#
&tr.tc007 test_jitstats_fn=
  @if cand(u(me/tr.has_jit),strmatch(config(jit_eval_brackets),1))=
  {
    &t7.in me=abcdefghij;
    &t7.s0 me=[jitstats()];
    &t7.top me=[strlen(get(me/t7.in))];
    &t7.s1 me=[jitstats()];
    &t7.nst me=[add(u(me/t7.probe),0)];
    &t7.s2 me=[jitstats()];
    @if cand(
          strmatch(v(t7.top),10),
          strmatch(v(t7.nst),10),
          gt(u(me/t7.kv,v(t7.s1),tier2),u(me/t7.kv,v(t7.s0),tier2)),
          gt(u(me/t7.kv,v(t7.s1),ecalls),u(me/t7.kv,v(t7.s0),ecalls)),
          gt(u(me/t7.kv,v(t7.s2),tier2),u(me/t7.kv,v(t7.s1),tier2)),
          gt(sub(u(me/t7.kv,v(t7.s2),ecalls),u(me/t7.kv,v(t7.s1),ecalls)),1)
        )=
    {
      @log smoke=TC007: jitstats counts nested Tier 2 and ECALLs. Succeeded (top tier2 [u(me/t7.kv,v(t7.s0),tier2)] to [u(me/t7.kv,v(t7.s1),tier2)], nested tier2 to [u(me/t7.kv,v(t7.s2),tier2)], nested ecalls [u(me/t7.kv,v(t7.s1),ecalls)] to [u(me/t7.kv,v(t7.s2),ecalls)]).
    },
    {
      @log smoke=TC007: jitstats counts nested Tier 2 and ECALLs. Failed (top=[v(t7.top)] nested=[v(t7.nst)] tier2 [u(me/t7.kv,v(t7.s0),tier2)]/[u(me/t7.kv,v(t7.s1),tier2)]/[u(me/t7.kv,v(t7.s2),tier2)] ecalls [u(me/t7.kv,v(t7.s0),ecalls)]/[u(me/t7.kv,v(t7.s1),ecalls)]/[u(me/t7.kv,v(t7.s2),ecalls)]).
    }
  },
  {
    @log smoke=TC007: jitstats counts nested Tier 2 and ECALLs. Skipped (JIT not enabled or jit_eval_brackets 0).
  }
-
&tr.done test_jitstats_fn=
  @log smoke=End jitstats() test cases.;
  @notify smoke
-
drop test_jitstats_fn
-
