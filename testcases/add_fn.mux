#
# add_fn.mux - Test Cases for add().
#
@create test_add_fn
-
@set test_add_fn=INHERIT QUIET
-
#
# Beginning of Test Cases
#
&tr.tc000 test_add_fn=
  @log smoke=Beginning add() test cases.
-
#
# Test Case #1 - Basic addition operations.
#
&tr.tc001 test_add_fn=
  @if cand(
        eq(add(1,2), 3),
        eq(add(1,2,3), 6),
        eq(add(-1,1), 0)
      )=
  {
    @log smoke=TC001: add basic operations. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC001: add basic operations. Failed (add(1%,2)=[add(1,2)] add(1%,2%,3)=[add(1,2,3)] add(-1%,1)=[add(-1,1)]).;
  }
-
#
# Test Case #2 - Decimal and coercion cases.
#
&tr.tc002 test_add_fn=
  @if cand(
        strmatch(add(1.5,2.25),3.75),
        eq(add(-5,2,1),-2),
        eq(add(),0),
        eq(add(foo,2),2)
      )=
  {
    @log smoke=TC002: add decimal and coercion cases. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC002: add decimal and coercion cases. Failed (add(1.5%,2.25)=[add(1.5,2.25)] add(-5%,2%,1)=[add(-5,2,1)] add()=[add()] add(foo%,2)=[add(foo,2)]).;
    @trig me/tr.done
  }
-
#
# Test Case #3 - Adding 0 returns the operand unchanged.
#
# add() routes through AddDoubles(), which finishes with NearestPretty().
# Same requirement as mul() TC003: an operand that is already its own
# shortest round-trip form must survive the +/- 4 ulp search intact.  A
# tie-break preferring a lower neighbour returns 1.224744871391588 here.
#
&tr.tc003 test_add_fn=
  @if cand(
        strmatch(add(1.224744871391589,0),1.224744871391589),
        strmatch(add(2.449489742783178,0),2.449489742783178),
        strmatch(add(sqrt(1.5),0),[sqrt(1.5)])
      )=
  {
    @log smoke=TC003: add identity preserves the operand. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC003: add identity preserves the operand. Failed (a=[add(1.224744871391589,0)] b=[add(2.449489742783178,0)] sq=[add(sqrt(1.5),0)]/[sqrt(1.5)]).;
    @trig me/tr.done
  }
-
#
# Test Case #4 - AddDoubles still compensates and prettifies.  0.1+0.2
# is the classic case: the raw IEEE sum is 0.30000000000000004.
#
&tr.tc004 test_add_fn=
  @if cand(
        strmatch(add(0.1,0.2),0.3),
        strmatch(add(1.5,2.5),4),
        strmatch(add(0.1,0.2,0.3),0.6)
      )=
  {
    @log smoke=TC004: add compensation retained. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC004: add compensation retained. Failed (classic=[add(0.1,0.2)] whole=[add(1.5,2.5)] three=[add(0.1,0.2,0.3)]).;
    @trig me/tr.done
  }
-
&tr.done test_add_fn=
  @log smoke=End add() test cases.;
  @notify smoke
-
drop test_add_fn
-
#
# End of Test Cases
#
