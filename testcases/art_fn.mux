#
# art_fn.mux - Test Cases for art().
#
# art(<string>) returns the English indefinite article, "a" or "an".
# The scanner is art_scan.rl (#1170: catch-all must be LAST so vowel and
# exception rules can win equal-length ties).
#
@create test_art_fn
-
@set test_art_fn=INHERIT QUIET
-
&tr.tc000 test_art_fn=
  @log smoke=Beginning art() test cases.
-
#
# Test Case #1 - Consonant-initial words take "a".  Documented example
# art(TinyMUX).
#
&tr.tc001 test_art_fn=
  @if cand(
        strmatch(art(TinyMUX), a),
        strmatch(art(cat), a),
        strmatch(art(box), a),
        strmatch(art(dog), a)
      )=
  {
    @log smoke=TC001: art consonant initial. Succeeded.
  },
  {
    @log smoke=TC001: art consonant initial. Failed (mux=[art(TinyMUX)] cat=[art(cat)] box=[art(box)] dog=[art(dog)]).
  }
-
#
# Test Case #2 - Vowel-initial words take "an".  These are the cases
# that #1170 permanently returned as "a".
#
&tr.tc002 test_art_fn=
  @if cand(
        strmatch(art(umbrella), an),
        strmatch(art(apple), an),
        strmatch(art(elephant), an),
        strmatch(art(avocado), an),
        strmatch(art(igloo), an),
        strmatch(art(orange), an)
      )=
  {
    @log smoke=TC002: art vowel initial. Succeeded.
  },
  {
    @log smoke=TC002: art vowel initial. Failed (umb=[art(umbrella)] apple=[art(apple)] ele=[art(elephant)] avo=[art(avocado)] igl=[art(igloo)] ora=[art(orange)]).
  }
-
#
# Test Case #3 - Documented exceptions: silent-h / y- / vowel-that-sounds
# like a consonant.
#
&tr.tc003 test_art_fn=
  @if cand(
        strmatch(art(hour), an),
        strmatch(art(heir), an),
        strmatch(art(ytterbium), an),
        strmatch(art(unicycle), a),
        strmatch(art(one-sided), a),
        strmatch(art(use), a)
      )=
  {
    @log smoke=TC003: art documented exceptions. Succeeded.
  },
  {
    @log smoke=TC003: art documented exceptions. Failed (hour=[art(hour)] heir=[art(heir)] yt=[art(ytterbium)] uni=[art(unicycle)] one=[art(one-sided)] use=[art(use)]).
  }
-
#
# Test Case #4 - The result is always one of the two articles and never
# empty.
#
&tr.tc004 test_art_fn=
  @if cand(
        t(member(a an, art(cat))),
        t(member(a an, art(umbrella))),
        t(member(a an, art(1234))),
        gt(strlen(art(x)), 0)
      )=
  {
    @log smoke=TC004: art always yields an article. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC004: art always yields an article. Failed (cat=[art(cat)] umb=[art(umbrella)] num=[art(1234)] x=[art(x)]).;
    @trig me/tr.done
  }
-
&tr.done test_art_fn=
  @log smoke=End art() test cases.;
  @notify smoke
-
drop test_art_fn
-
#
# End of Test Cases
#
