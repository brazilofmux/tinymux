#
# benchmark_fn.mux - Test Cases for benchmark().
#
@create test_benchmark_fn
-
@set test_benchmark_fn=INHERIT QUIET
-
#
# Beginning of Test Cases
#
&tr.tc000 test_benchmark_fn=
  @log smoke=Beginning benchmark() test cases.
-
#
# Test Case #1 - Basic benchmark returns a positive number.
#
&tr.tc001 test_benchmark_fn=
  @if gt(
        setr(0,benchmark(add(1,2), 100)),
        0
      )=
  {
    @log smoke=TC001: benchmark returns positive. Succeeded.
  },
  {
    @log smoke=TC001: benchmark returns positive. Failed (%q0).
  }
-
#
# Test Case #2 - More iterations take more time.
#
&tr.tc002 test_benchmark_fn=
  @if gte(
        setr(0,benchmark(add(1,2), 1000)),
        setr(1,benchmark(add(1,2), 1))
      )=
  {
    @log smoke=TC002: more iterations take more time. Succeeded.
  },
  {
    @log smoke=TC002: more iterations >= single. Failed (%q0 vs %q1).
  }
-
#
# Test Case #3 - Error path: non-positive and unevaluated (FN_NOEVAL) iterations.
#
&tr.tc003 test_benchmark_fn=
  @if cand(
        strmatch(benchmark(add(1,2), 0), #-1 ITERATIONS MUST BE POSITIVE),
        strmatch(benchmark(add(1,2), -5), #-1 ITERATIONS MUST BE POSITIVE),
        strmatch(benchmark(add(1,2), add(0,1)), #-1 ITERATIONS MUST BE POSITIVE)
      )=
  {
    @log smoke=TC003: benchmark() error paths. Succeeded.
  },
  {
    @log smoke=TC003: benchmark() error paths. Failed (zero=[benchmark(add(1,2),0)] neg=[benchmark(add(1,2),-5)] noeval=[benchmark(add(1,2),add(0,1))]).
  }
-
#
# Test Case #4 - The iteration cap REFUSES; it must not silently clamp.
#
# benchmark() returns raw elapsed seconds, so the caller divides by the count
# it asked for.  A silent clamp therefore does not shrink the experiment, it
# scales every derived us/call by the clamp ratio with nothing in the output
# saying so (#2133).  Pin the boundary on both sides: at the cap must still
# measure, one over must refuse.
#
&tr.tc004 test_benchmark_fn=
  @if cand(
        gt(setr(0,benchmark(add(1,2), 10000)), 0),
        strmatch(setr(1,benchmark(add(1,2), 10001)), #-1 ITERATIONS EXCEEDS 10000),
        strmatch(setr(2,benchmark(add(1,2), 200000)), #-1 ITERATIONS EXCEEDS 10000)
      )=
  {
    @log smoke=TC004: benchmark() refuses above the cap. Succeeded.;
    @trig me/tr.done
  },
  {
    @log smoke=TC004: benchmark() refuses above the cap. Failed (atcap=%q0 over=%q1 wayover=%q2).;
    @trig me/tr.done
  }
-
&tr.done test_benchmark_fn=
  @log smoke=End benchmark() test cases.;
  @notify smoke
-
drop test_benchmark_fn
-
#
# End of Test Cases
#
