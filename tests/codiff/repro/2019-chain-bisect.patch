+/* --- #2019 bisection instrumentation (scratch build only) ---
+ * DBT_CHAIN_DUMP=1        list every guest PC that gets chained
+ * DBT_CHAIN_SKIP=a,b,c    skip backpatching for those target PCs (hex)
+ */
+#include <set>
+static std::set<uint64_t> g_chained;
+static bool g_chain_skip(uint64_t pc) {
+    static const char *env = getenv("DBT_CHAIN_SKIP");
+    if (!env || !*env) return false;
+    char buf[32];
+    snprintf(buf, sizeof buf, "%llx", (unsigned long long)pc);
+    const char *p = env;
+    size_t n = strlen(buf);
+    while ((p = strstr(p, buf)) != nullptr) {
+        bool lb = (p == env) || (p[-1] == ',');
+        bool rb = (p[n] == '\0') || (p[n] == ',');
+        if (lb && rb) return true;
+        p += n;
+    }
+    return false;
+}
